# Copy to .env.local and fill privately. Never commit real values.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=<development-publishable-key>
CLERK_SECRET_KEY=<development-secret-key>
NEXT_PUBLIC_CONVEX_URL=<existing-development-convex-url>
# Configure this issuer on the approved Convex deployment as well.
# S02.3 account access requires the deployed users schema/functions and Clerk convex JWT template.
CLERK_JWT_ISSUER_DOMAIN=<existing-development-clerk-issuer>
# Auth URLs and /dashboard fallbacks are set in application code.
